# Railway Postgres. Use Railway's pooled connection string in production.
DATABASE_URL="postgresql://user:password@host:port/railway"

# Admin auth. JWT_SECRET signs session cookies.
JWT_SECRET="change-me-in-production"
# First-sign-in bootstrap only: while no admin accounts exist, these
# credentials are accepted once and become the Owner account. After that,
# accounts are managed in /admin/team (and recovered with
# `npm run admin:reset-password -- <username> <new-password>`).
# Generate the hash with `npm run hash-password`.
ADMIN_USERNAME="melissa"
ADMIN_PASSWORD_HASH=""

# Cloudinary (Plan 02 uses this)
CLOUDINARY_URL=""

# SEO & analytics (optional — features stay off when unset).
# Google Search Console HTML-tag verification code (content="..." value only).
# Not needed if you verify the domain property via a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=""
# GA4 web data stream Measurement ID, e.g. G-XXXXXXXXXX. Set it for the
# Production environment only so previews don't send hits. Publish a privacy
# notice that mentions Google Analytics before enabling it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
